<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/harsh_black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/harsh_black"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Lightweight overlay: only shown on interaction, auto-hides -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_scrim"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_harsh_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/harsh_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/harsh_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFavorite"
                style="@style/Harsh.PlayerButton"
                android:contentDescription="@string/action_favorite"
                android:src="@drawable/ic_star" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_controls"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/harsh_white"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <TextView
                    android:id="@+id/remainingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/harsh_white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/totalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/harsh_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrev"
                    style="@style/Harsh.PlayerButton"
                    android:contentDescription="@string/action_prev"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/btnBackward"
                    style="@style/Harsh.PlayerButton"
                    android:contentDescription="@string/action_back10"
                    android:src="@drawable/ic_backward" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    style="@style/Harsh.PlayerButton"
                    android:contentDescription="@string/action_play_pause"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/btnForward"
                    style="@style/Harsh.PlayerButton"
                    android:contentDescription="@string/action_forward10"
                    android:src="@drawable/ic_forward" />

                <ImageButton
                    android:id="@+id/btnNext"
                    style="@style/Harsh.PlayerButton"
                    android:contentDescription="@string/action_next"
                    android:src="@drawable/ic_next" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    style="@style/Harsh.PlayerButton"
                    android:contentDescription="@string/player_settings"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>

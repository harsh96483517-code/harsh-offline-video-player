<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Harsh" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/harsh_black</item>
        <item name="android:colorBackground">@color/harsh_black</item>
        <item name="android:textColorPrimary">@color/harsh_white</item>
        <item name="android:textColorSecondary">@color/harsh_text_dim</item>
        <item name="colorAccent">@color/harsh_blue</item>
        <item name="android:statusBarColor">@color/harsh_black</item>
        <item name="android:navigationBarColor">@color/harsh_black</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Harsh.Splash">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <!-- Base style: the "Harsh.*" component styles below inherit from this. -->
    <style name="Harsh" />

    <!-- Top bar icon button -->
    <style name="Harsh.TopBarButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/selector_icon_button</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/harsh_white</item>
    </style>

    <!-- Player control button -->
    <style name="Harsh.PlayerButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/selector_icon_button</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/harsh_white</item>
    </style>

    <style name="Harsh.SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Harsh.SettingLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/harsh_white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Harsh.ActionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/selector_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/harsh_white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Harsh.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@color/harsh_border</item>
    </style>

</resources>
